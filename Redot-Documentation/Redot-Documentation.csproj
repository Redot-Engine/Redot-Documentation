<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Redot_Documentation</RootNamespace>
        <AssemblyName>$(AssemblyName.Replace(' ', '_'))</AssemblyName>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Redot-Documentation-Tests" />
        <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
        <PackageReference Include="Lucene.Net" Version="4.8.0-beta00017" />
        <PackageReference Include="Lucene.Net.Analysis.Common" Version="4.8.0-beta00017" />
        <PackageReference Include="MudBlazor" Version="9.9.0" />
        <ProjectReference Include="..\Redot-Documentation.Client\Redot-Documentation.Client.csproj" />
        <PackageReference Include="Markdig" Version="0.41.3" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.7" />
    </ItemGroup>
    <ItemGroup>
        <None Update="docs/**" CopyToOutputDirectory="PreserveNewest">
        </None>
    </ItemGroup>
    <ItemGroup>
      <Folder Include="wwwroot\Icons\" />
    </ItemGroup>

    <!-- Keep canonical license/author files available in both the site and publish output. -->
    <ItemGroup>
        <Content Include="../LICENSE.txt" Link="wwwroot/licenses/WEBSITE-MIT.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="docs/LICENSE.txt" Link="wwwroot/licenses/CC-BY-3.0.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="../GODOT_AUTHORS.md" Link="wwwroot/licenses/GODOT_AUTHORS.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="../REDOT_AUTHORS.md" Link="wwwroot/licenses/REDOT_AUTHORS.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="../LICENSING.md" Link="LICENSING.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
