{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ClassDocumentation": {
    "Enabled": true,
    "RepositoryUrl": "https://github.com/Redot-Engine/redot-engine.git",
    "RepositoryPath": "doc/classes",
    "CacheRoot": "App_Data/class-docs",
    "RefreshInterval": "1.00:00:00",
    "GitTimeout": "00:05:00"
  },
  "AllowedHosts": "*"
}
