@using Redot_Documentation.Services
@using Redot_Documentation.Versioning
@implements IDisposable
@inject VersionManagerService VersionManagerService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">
            <div class="horizontal-stack">
                <div class="redot-logo-icon">Redot Docs</div>
                Redot Docs
            </div>
            
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>

            <label class="version-label" for="version-selector">Version</label>
            <select id="version-selector" class="version-select" @onchange="OnVersionChanged" value="@_selectedVersionSlug">
                @foreach (DocumentationVersion version in _availableVersions)
                {
                    <option value="@version.Slug">@version.FriendlyName</option>
                }
            </select>

            @foreach (IRanking ranking in _rankings)
            {
                @if (ranking is Article article)
                {
                    <NavLink class="nav-link nav-article-link" href="@GetArticleLink(article)">
                        @NormalizeArticleName(article.DisplayName)
                    </NavLink>
                }
                else if (ranking is Section section)
                {
                    <NavSectionTree Section="section" BuildArticleLink="GetArticleLink" Level="0" />
                }
            }
        </div>


    </nav>
</div>

@code {
    private IReadOnlyList<DocumentationVersion> _availableVersions = [];
    private string _selectedVersionSlug = string.Empty;
    private VersionProvider? _selectedVersionProvider;
    private IRanking[] _rankings = [];

    protected override void OnInitialized()
    {
        _availableVersions = VersionManagerService.Versions;
        if (_availableVersions.Count == 0)
        {
            _rankings = [];
            return;
        }

        SelectVersionFromLocation();
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnVersionChanged(ChangeEventArgs changeEventArgs)
    {
        string? selectedVersion = changeEventArgs.Value?.ToString();
        if (string.IsNullOrWhiteSpace(selectedVersion))
            return;

        _selectedVersionSlug = selectedVersion;
        LoadRankings();

        string versionLandingPath = GetVersionLandingPath(_selectedVersionProvider!);
        NavigationManager.NavigateTo(versionLandingPath);
    }

    private void LoadRankings()
    {
        _selectedVersionProvider = VersionManagerService.GetVersionProvider(_selectedVersionSlug);
        _selectedVersionProvider.SortRankings();
        _rankings = _selectedVersionProvider.GetSortedRankings();
    }

    private string GetArticleLink(Article article)
    {
        string normalizedPath = _selectedVersionProvider!.GetReferentialPath(article.Path);

        if (normalizedPath.EndsWith(".md", StringComparison.OrdinalIgnoreCase))
            normalizedPath = normalizedPath[..^3];

        return normalizedPath;
    }

    private void SelectVersionFromLocation()
    {
        string relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        string pathWithoutQueryOrFragment = relativePath.Split(['?', '#'], 2)[0].Trim('/');
        string[] segments = pathWithoutQueryOrFragment.Split('/', StringSplitOptions.RemoveEmptyEntries);

        VersionProvider? provider = null;
        if (segments.Length >= 2 && string.Equals(segments[0], "en", StringComparison.OrdinalIgnoreCase))
            VersionManagerService.TryGetVersionProvider(segments[1], out provider);

        _selectedVersionSlug = provider?.Version.Slug ?? VersionManagerService.LatestStableVersion.Slug;
        LoadRankings();
    }

    private string GetVersionLandingPath(VersionProvider provider)
    {
        Article? landingArticle = provider.VersionedDocsSection is null
            ? null
            : FindFirstArticle(provider.VersionedDocsSection);

        return landingArticle is null
            ? $"/en/{provider.Version.Slug}/"
            : GetArticleLink(landingArticle);
    }

    private static Article? FindFirstArticle(Section section)
    {
        if (section.IndexArticle is not null)
            return section.IndexArticle;

        foreach (IRanking ranking in section.GetSortedRankings())
        {
            if (ranking is Article article)
                return article;

            if (ranking is Section subsection && FindFirstArticle(subsection) is Article subsectionArticle)
                return subsectionArticle;
        }

        return null;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs locationChangedEventArgs)
    {
        _ = InvokeAsync(() =>
        {
            SelectVersionFromLocation();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private static string NormalizeArticleName(string articleName)
        => articleName.EndsWith(".md", StringComparison.OrdinalIgnoreCase)
            ? articleName[..^3]
            : articleName;
}
