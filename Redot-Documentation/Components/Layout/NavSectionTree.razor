@using Redot_Documentation.Versioning
@inject NavigationManager Navigation

<MudNavGroup Title="@Section.DisplayName" @bind-Expanded="_expanded">
    @if (_expanded)
    {
        @if (Section.IndexArticle is not null)
        {
            <MudNavLink Href="@BuildArticleLink(Section.IndexArticle)" Match="NavLinkMatch.All">Overview</MudNavLink>
        }
        @foreach (IRanking ranking in Section.GetSortedRankings())
        {
            if (ranking is Article article)
            {
                <MudNavLink Href="@BuildArticleLink(article)" Match="NavLinkMatch.All">@article.DisplayName.Replace(".md", "").Replace('_', ' ')</MudNavLink>
            }
            else if (ranking is Section child)
            {
                <NavSectionTree @key="child.Path" Section="child" BuildArticleLink="BuildArticleLink" Level="@(Level + 1)" />
            }
        }
    }
</MudNavGroup>

@code {
    [Parameter, EditorRequired] public Section Section { get; set; } = null!;
    [Parameter, EditorRequired] public Func<Article, string> BuildArticleLink { get; set; } = null!;
    [Parameter] public int Level { get; set; }
    private bool _expanded;
    private string? _lastLocation;
    protected override void OnParametersSet()
    {
        if (_lastLocation == Navigation.Uri) return;
        _lastLocation = Navigation.Uri;
        _expanded = ContainsCurrentArticle(Section);
    }
    private bool ContainsCurrentArticle(Section section)
    {
        string current = Uri.UnescapeDataString(new Uri(Navigation.Uri).AbsolutePath).TrimEnd('/');
        if (current.EndsWith(".md", StringComparison.OrdinalIgnoreCase)) current = current[..^3];
        bool Matches(Article article) => current.Equals(Uri.UnescapeDataString(BuildArticleLink(article)).TrimEnd('/'), StringComparison.OrdinalIgnoreCase);
        return (section.IndexArticle is not null && Matches(section.IndexArticle))
            || section.Articles.Any(Matches) || section.SubSections.Any(ContainsCurrentArticle);
    }
}
