@using Redot_Documentation.Versioning
@using Redot_Documentation.Services
@inject NavigationManager Navigation
@inject DocumentPathResolver Paths
@inject VersionManagerService Versions

<MudNavGroup Title="@Section.DisplayName" @bind-Expanded="_expanded">
    @if (_expanded)
    {
        @if (Section.IndexArticle is not null)
        {
            <MudNavLink Href="@BuildArticleLink(Section.IndexArticle)" Class="@(Matches(Section.IndexArticle) ? "doc-current" : null)" Match="NavLinkMatch.All">Overview</MudNavLink>
        }
        @foreach (IRanking ranking in Section.GetSortedRankings())
        {
            if (ranking is Article article)
            {
                <MudNavLink Href="@BuildArticleLink(article)" Class="@(Matches(article) ? "doc-current" : null)" Match="NavLinkMatch.All">@article.DisplayName.Replace(".md", "").Replace('_', ' ')</MudNavLink>
            }
            else if (ranking is Section child)
            {
                <NavSectionTree @key="child.Path" Section="child" BuildArticleLink="BuildArticleLink" Level="@(Level + 1)" />
            }
        }
    }
</MudNavGroup>

@code {
    [Parameter, EditorRequired] public Section Section { get; set; } = null!;
    [Parameter, EditorRequired] public Func<Article, string> BuildArticleLink { get; set; } = null!;
    [Parameter] public int Level { get; set; }
    private bool _expanded;
    private string? _lastLocation;
    protected override void OnParametersSet()
    {
        if (_lastLocation == Navigation.Uri) return;
        _lastLocation = Navigation.Uri;
        _expanded = ContainsCurrentArticle(Section);
    }
    private bool Matches(Article article)
    {
        try
        {
            var path = Uri.UnescapeDataString(new Uri(Navigation.Uri).AbsolutePath);
            return path.StartsWith("/en/", StringComparison.OrdinalIgnoreCase)
                && Paths.ResolveRoute(path[4..], Versions)?.FullPath == article.Path;
        }
        catch (ArgumentException) { return false; }
    }

    private bool ContainsCurrentArticle(Section section)
        => (section.IndexArticle is not null && Matches(section.IndexArticle))
            || section.Articles.Any(Matches) || section.SubSections.Any(ContainsCurrentArticle);
}
