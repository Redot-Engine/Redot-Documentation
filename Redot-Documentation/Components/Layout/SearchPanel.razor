@using Redot_Documentation.Search
@using Redot_Documentation.Services
@using System.Text.RegularExpressions
@using System.Net
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IDocumentationSearch SearchService
@inject VersionManagerService Versions
@inject NavigationManager Navigation

<div class="search-panel" @ref="_panel">
    <MudTextField Class="search-query" T="string" Value="@_query" ValueChanged="QueryChanged" Label="Search documentation" Placeholder="Search page contents, classes, and methods…" Variant="Variant.Outlined" Immediate="true" AutoFocus="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" OnKeyDown="HandleKey" />
    <div class="search-filters">
        <MudSelect T="string" Label="Version" Value="@_version" ValueChanged="VersionChanged" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (var version in Versions.Versions) { <MudSelectItem T="string" Value="@version.Slug">@version.FriendlyName</MudSelectItem> }
        </MudSelect>
        <MudSelect T="string" Label="Search in" Value="@_kind" ValueChanged="KindChanged" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem T="string" Value='@("all")'>All</MudSelectItem>
            <MudSelectItem T="string" Value='@("guides")'>Guides &amp; tutorials</MudSelectItem>
            <MudSelectItem T="string" Value='@("classes")'>Class reference</MudSelectItem>
        </MudSelect>
    </div>
    <div role="status" aria-live="polite" class="search-status">
        <span class="search-summary">
            @if (_displayQuery.Length == 0) { <span>Search explanations, code samples, and API names.</span> }
            else if (!_response.Available) { <span>Search is preparing this version. Please try again shortly.</span> }
            else { <span>@_response.Hits.Count@(_response.HasMore ? "+" : "") results</span> }
        </span>
        <span class="search-loading" style="visibility:@(_showLoading ? "visible" : "hidden")">Searching…</span>
        <span class="search-announcement">@(_selected >= 0 ? $"{_response.Hits[_selected].Title}: {_response.Hits[_selected].Heading}" : "")</span>
    </div>
    <div class="search-result-region" aria-busy="@_busy.ToString().ToLowerInvariant()">
    @if (_response.Available && _displayQuery.Length > 0 && _response.Hits.Count == 0)
    { <MudText>No matches. Try fewer words or a different version.</MudText> }
    <div class="search-results">
        @for (int i = 0; i < _response.Hits.Count; i++)
        {
            var hit = _response.Hits[i];
            <a @key="hit.Url" href="@hit.Url" class="search-result @(i == _selected ? "selected" : "")" @onclick="() => ResultChosen.InvokeAsync()">
                <span class="search-result-kind">@(hit.Kind == "classes" ? "Class reference" : "Documentation") · @Uri.UnescapeDataString(hit.Url.Split('#')[0].Replace("/en/", ""))</span>
                <strong>@hit.Title@if (hit.Heading != hit.Title) { <span> › @hit.Heading</span> }</strong>
                <span>@Highlight(hit.Snippet)</span>
            </a>
        }
    </div>
    </div>
    <div class="search-actions">
    @if (!FullPage && _query.Trim().Length > 0)
    { <MudButton Href="@ResultsUrl" OnClick="() => ResultChosen.InvokeAsync()" Color="Color.Primary">View all results</MudButton> }
    @if (FullPage && _response.HasMore && _limit < 100)
    { <MudButton OnClick="More" Color="Color.Primary">Show more results</MudButton> }
    </div>
</div>

@code {
    [Parameter] public string? Query { get; set; }
    [Parameter] public string? Version { get; set; }
    [Parameter] public string? Kind { get; set; }
    [Parameter] public bool FullPage { get; set; }
    [Parameter] public EventCallback ResultChosen { get; set; }
    private string _query = "", _version = "", _kind = "all";
    private int _selected = -1, _limit = 30;
    private bool _busy, _showLoading, _disposed, _scrollSelection;
    private long _requestId;
    private string _displayQuery = "";
    private (string?, string?, string?)? _parameters;
    private ElementReference _panel;
    private IJSObjectReference? _module;
    private CancellationTokenSource? _pending;
    private SearchResponse _response = new(true, []);
    private string ResultsUrl => $"/search?q={Uri.EscapeDataString(_query)}&version={Uri.EscapeDataString(_version)}&kind={_kind}";
    protected override async Task OnParametersSetAsync()
    {
        var incoming = (Query, Version, Kind);
        if (_parameters == incoming) return;
        _parameters = incoming;
        string query = Query ?? "";
        string version = Versions.TryGetVersionProvider(Version ?? "", out _) ? Version! : Versions.LatestStableVersion.Slug;
        string kind = Kind is "guides" or "classes" ? Kind : "all";
        if ((_query, _version, _kind) == (query, version, kind)) return;
        (_query, _version, _kind) = (query, version, kind);
        _limit = 30;
        await Run(false);
    }
    private async Task QueryChanged(string value) { _query = value; _limit = 30; await Run(true); }
    private async Task VersionChanged(string value) { _version = value; await Run(false); }
    private async Task KindChanged(string value) { _kind = value; await Run(false); }
    private async Task More() { _limit += 30; await Run(false); }
    private async Task Run(bool debounce)
    {
        _pending?.Cancel();
        long request = ++_requestId;
        var pending = _pending = new CancellationTokenSource();
        string query = _query.Trim(), version = _version, kind = _kind;
        int limit = FullPage ? _limit : 10;
        _busy = query.Length > 0;
        _showLoading = false;
        _selected = -1;
        _scrollSelection = false;
        try
        {
            if (query.Length == 0)
            {
                _response = new(true, []);
                _displayQuery = "";
                SyncUrl();
                return;
            }
            _ = ShowLoadingAsync(request, pending.Token);
            if (debounce) await Task.Delay(200, pending.Token);
            var result = await Task.Run(() => SearchService.Search(version, query, kind, limit), pending.Token);
            if (_disposed || request != _requestId || pending.IsCancellationRequested) return;
            _response = result;
            _displayQuery = query;
            SyncUrl();
        }
        catch (OperationCanceledException) { }
        finally
        {
            pending.Cancel();
            if (request == _requestId) { _busy = false; _showLoading = false; _pending = null; }
            pending.Dispose();
        }
    }
    private void SyncUrl()
    {
        if (FullPage && new Uri(Navigation.Uri).PathAndQuery != ResultsUrl)
            Navigation.NavigateTo(ResultsUrl, replace: true);
    }
    private async Task ShowLoadingAsync(long request, CancellationToken token)
    {
        try
        {
            await Task.Delay(400, token);
            await InvokeAsync(() =>
            {
                if (!_disposed && request == _requestId && _busy)
                { _showLoading = true; StateHasChanged(); }
            });
        }
        catch (OperationCanceledException) { }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/search.js");
        if (_scrollSelection && _module is not null)
        {
            _scrollSelection = false;
            await _module.InvokeVoidAsync("scrollSelected", _panel);
        }
    }
    private async Task HandleKey(KeyboardEventArgs args)
    {
        if (_busy || _response.Hits.Count == 0) return;
        if (args.Key == "ArrowDown") _selected = (_selected + 1) % _response.Hits.Count;
        if (args.Key == "ArrowUp") _selected = (_selected + _response.Hits.Count - 1) % _response.Hits.Count;
        if (args.Key is "ArrowDown" or "ArrowUp") _scrollSelection = true;
        if (args.Key == "Enter")
        {
            var hit = _response.Hits[Math.Max(0,_selected)];
            await ResultChosen.InvokeAsync();
            Navigation.NavigateTo(hit.Url);
        }
    }
    private MarkupString Highlight(string text)
    {
        var terms = SearchContent.Terms(_displayQuery).OrderByDescending(t => t.Length).Select(Regex.Escape).ToArray();
        if (terms.Length == 0) return new(WebUtility.HtmlEncode(text));
        var output = new System.Text.StringBuilder();
        int start = 0;
        foreach (Match match in Regex.Matches(text,string.Join('|',terms),RegexOptions.IgnoreCase))
        {
            output.Append(WebUtility.HtmlEncode(text[start..match.Index]));
            output.Append("<mark>").Append(WebUtility.HtmlEncode(match.Value)).Append("</mark>");
            start = match.Index + match.Length;
        }
        return new(output.Append(WebUtility.HtmlEncode(text[start..])).ToString());
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        ++_requestId;
        _pending?.Cancel();
        try { if (_module is not null) await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
