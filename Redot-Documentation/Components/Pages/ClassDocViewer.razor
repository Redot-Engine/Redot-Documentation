@page "/en/{VersionSlug}/Classes"
@page "/en/{VersionSlug}/Classes/{ClassName}"
@layout MainLayout
@using Redot_Documentation.ClassDocumentation
@implements IDisposable
@inject ClassDocumentationCatalog Catalog
@inject ClassDocumentationRenderer Renderer
@inject IJSRuntime JS

<PageTitle>@PageTitleText</PageTitle>

@if (_snapshot is null)
{
    <h1>Classes</h1>
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        Class documentation is not available for this version.
    </MudAlert>
}
else if (!string.IsNullOrWhiteSpace(ClassName))
{
    @if (_classDocumentation is null)
    {
        <h1>Class not found</h1>
        <p><code>@ClassName</code> is not present in @(_snapshot.Version.FriendlyName).</p>
        <p><a href="@ClassesIndexPath">Browse classes for this version</a></p>
    }
    else
    {
        <div class="doc-viewer-content class-doc-viewer">
            @((MarkupString)Renderer.RenderPage(_classDocumentation, _snapshot))
            <DocumentationAttribution ClassReference="true" />
        </div>
    }
}
else
{
    <div class="doc-viewer-content class-index">
        <p class="class-reference-kicker">@_snapshot.Version.FriendlyName</p>
        <h1>Classes</h1>
        <p>API reference synchronized from Redot Engine revision <code>@ShortCommit</code>.</p>

        <MudTextField T="string" @bind-Value="_searchText" Label="Find a class"
                      Placeholder="@($"Search {_snapshot.Classes.Count} classes")"
                      Variant="Variant.Outlined" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                      Clearable="true" Class="class-search-field" />

        @if (FilteredClasses.Count == 0)
        {
            <p>No classes match <strong>@_searchText</strong>.</p>
        }
        else
        {
            @foreach (IGrouping<char, ClassDocumentationEntry> group in FilteredClasses.GroupBy(GetInitial))
            {
                <section class="class-index-group">
                    <h2>@group.Key</h2>
                    <ul class="class-index-list">
                        @foreach (ClassDocumentationEntry entry in group)
                        {
                            <li>
                                <a href="@ClassDocumentationRenderer.ClassPath(VersionSlug, entry.Name)"><code>@entry.Name</code></a>
                                @if (!string.IsNullOrWhiteSpace(entry.BriefDescription))
                                {
                                    <span>@FirstSentence(entry.BriefDescription)</span>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }
        }
        <DocumentationAttribution ClassReference="true" />
    </div>
}

@code {
    [Parameter]
    public string VersionSlug { get; set; } = string.Empty;

    [Parameter]
    public string? ClassName { get; set; }

    private ClassDocumentationSnapshot? _snapshot;
    private ClassDocumentationEntry? _classDocumentation;
    private string _searchText = string.Empty;
    private bool _disposed;

    private string ClassesIndexPath => $"/en/{Uri.EscapeDataString(VersionSlug)}/Classes";
    private string ShortCommit => _snapshot is null
        ? string.Empty
        : _snapshot.CommitSha[..Math.Min(12, _snapshot.CommitSha.Length)];
    private string PageTitleText => _classDocumentation is null ? "Classes" : $"{_classDocumentation.Name} class";

    private IReadOnlyList<ClassDocumentationEntry> FilteredClasses => _snapshot?.Classes.Values
        .Where(entry => string.IsNullOrWhiteSpace(_searchText)
            || entry.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            || entry.BriefDescription.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
        .OrderBy(entry => entry.Name, StringComparer.OrdinalIgnoreCase)
        .ToArray() ?? [];

    protected override void OnInitialized()
        => Catalog.Changed += OnCatalogChanged;

    protected override void OnParametersSet() => LoadSnapshot();

    private void LoadSnapshot()
    {
        _classDocumentation = null;
        Catalog.TryGetSnapshot(VersionSlug, out _snapshot);
        if (_snapshot is not null && !string.IsNullOrWhiteSpace(ClassName))
            _snapshot.TryGetClass(ClassName, out _classDocumentation);
    }

    private void OnCatalogChanged(string versionSlug)
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed || !string.Equals(versionSlug, VersionSlug, StringComparison.OrdinalIgnoreCase))
                return;

            LoadSnapshot();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        Catalog.Changed -= OnCatalogChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_classDocumentation is not null)
            await JS.InvokeVoidAsync("highlightCode");
    }

    private static char GetInitial(ClassDocumentationEntry entry)
    {
        string name = entry.Name.TrimStart('@');
        return name.Length == 0 ? '#' : char.ToUpperInvariant(name[0]);
    }

    private static string FirstSentence(string description)
    {
        string plainText = System.Text.RegularExpressions.Regex.Replace(description, @"\[[^\]]+\]", string.Empty)
            .Replace('\n', ' ')
            .Trim();
        int sentenceEnd = plainText.IndexOf(". ", StringComparison.Ordinal);
        string summary = sentenceEnd >= 0 ? plainText[..(sentenceEnd + 1)] : plainText;
        return summary.Length > 180 ? $"{summary[..177]}..." : summary;
    }
}
